# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` git'e eklenmez.

# --- Django ---
DJANGO_SECRET_KEY=degistir-beni-uzun-rastgele-bir-anahtar
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=oktopi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- API dokümantasyonu (/api/docs/ Swagger, /api/redoc/, /api/schema/) ---
API_DOCS_ENABLED=True

# --- CORS (frontend adresleri, virgülle ayrılır) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
# Boş bırakılırsa Vite proxy üzerinden /api kullanılır.
# VITE_API_BASE_URL=http://localhost:8000/api
