      "learning_outcome": "MAT.9.1.3",
      "difficulty": "easy",
      "question_text": "$\\sqrt{9 + 16}$ işleminin sonucu kaçtır?",
      "options": [
        {
          "key": "A",
          "text": "$5$",
          "is_correct": true,
          "misconception_tag": null,
          "misconception_detail": null,
          "recommended_subtopic_id": null
        },
        {
          "key": "B",
          "text": "$7$",
          "is_correct": false,
          "misconception_tag": "MISC_ROOT_SUM_SPLIT",
          "misconception_detail": "Toplamın karekökünü, kareköklerin toplamı gibi ayırma yanılgısı: $\\sqrt{9+16} = \\sqrt{9} + \\sqrt{16}$.",
          "recommended_subtopic_id": "top-9-root-def"
        },
        {
          "key": "C",
          "text": "$25$",
          "is_correct": false,
          "misconception_tag": "MISC_ROOT_FORGET_ROOT",
          "misconception_detail": "Kök içini hesaplayıp karekök almayı unutma.",
